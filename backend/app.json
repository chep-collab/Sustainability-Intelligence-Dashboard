{
  "build": {
    "builder": "heroku/buildpacks"
  },
  "env": {
    "MONGO_URI": {
      "description": "MongoDB connection string (MongoDB Atlas)",
      "required": true
    },
    "NODE_ENV": {
      "description": "Node environment (production/development)",
      "value": "production"
    },
    "PORT": {
      "description": "Server port",
      "value": "5000"
    },
    "MQTT_BROKER": {
      "description": "MQTT broker URL (optional, defaults to localhost:1883)",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
