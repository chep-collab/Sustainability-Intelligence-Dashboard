# MongoDB Connection URI
# Default: mongodb://127.0.0.1:27017/sustainability_dashboard
MONGO_URI=mongodb://127.0.0.1:27017/sustainability_dashboard

# API Server Port
# Default: 5000
PORT=5000

# Node Environment
NODE_ENV=development

# SMTP settings for sending donor emails (replace with your SMTP provider creds)
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL="Your Name <no-reply@yourorg.org>"

# Optional: URL where the frontend is hosted (used in email links)
FRONTEND_URL=http://localhost:3000

# Optional: Add any other env vars your app might need
# API_KEY=your_api_key_here
# LOG_LEVEL=debug
